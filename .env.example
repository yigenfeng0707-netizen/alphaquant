# AlphaQuant 环境变量示例
# 复制为 .env 并按需修改。所有变量均可选，不设则用默认值。

# --- 后端 ---
# 静态文件目录（前端 dist 路径，用于后端托管前端）
# STATIC_DIR=

# 数据源模式: offline=离线合成数据 / auto=AKShare 实时（失败降级 offline）
# ALPHAQUANT_SOURCE=offline

# 离线数据目录
# ALPHAQUANT_OFFLINE_DIR=data/offline

# 审计日志目录
# ALPHAQUANT_AUDIT_DIR=data/audit

# 报告输出目录
# ALPHAQUANT_REPORTS_DIR=data/reports

# AKShare 单次请求超时（秒）
# ALPHAQUANT_TIMEOUT_SEC=8.0

# AKShare 整体超时（秒）
# ALPHAQUANT_OVERALL_SEC=20.0

# AKShare 基本面数据获取超时（秒）
# ALPHAQUANT_FUND_SEC=45.0

# 交易成本率（双边）
# ALPHAQUANT_COST=0.0015

# 滑点系数（平方根冲击模型）
# ALPHAQUANT_SLIPPAGE=0.001

# 案例 1 名义本金
# ALPHAQUANT_CAPITAL=100000

# 案例 2 名义本金（演示口径）
# ALPHAQUANT_CASE2_NOTIONAL=100000000

# 案例 1 选股数量
# ALPHAQUANT_CASE1_TOP_N=10

# 随机数种子（可复现性）
# ALPHAQUANT_RNG_SEED=20260909

# --- 前端 ---
# API 基础路径（开发模式留空走代理，生产指向后端地址）
# VITE_API_BASE=

# --- 保活脚本 ---
# Demo 公网地址
# ALPHAQUANT_DEMO_URL=https://gsym236998-alphaquant.ms.show

# --- 部署（魔搭 / Docker）---
# 端口
# PORT=8010
# 环境
# PYTHONPATH=backend
