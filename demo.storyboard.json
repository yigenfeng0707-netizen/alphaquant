{
  "name": "AlphaQuant",
  "version": "3min-standard",
  "durationTargetSeconds": 180,
  "playwrightDir": "frontend",
  "baseUrl": "http://localhost:3000",
  "healthUrl": "http://127.0.0.1:8010/health",
  "outputDir": "demo-output",
  "finalMp4": "demo-output/AlphaQuant_demo_cinematic_3min.mp4",
  "viewport": { "width": 1920, "height": 1080 },
  "voice": "zh-CN-YunxiNeural",
  "voiceRate": "-8%",
  "mode": "record",
  "burnSubtitles": true,
  "subtitles": true,
  "crf": 17,
  "preset": "medium",
  "audioBitrate": "192k",
  "note": "2026-09-10：每个 browser 场景必须 goto，因为引擎每段新开页面。preset medium 以免 CRF slow 空转过久。",
  "scenes": [
    {
      "id": "intro",
      "type": "image",
      "path": "assets/demo/intro-card.png",
      "narration": "您好，下面演示 AlphaQuant。这是面向中青年工程师创新创业大赛的可运行产品：多因子选股、风险平价、适当性匹配与机构研究流程。不是实盘交易，也没有接入大模型。",
      "minDuration": 12
    },
    {
      "id": "h1",
      "type": "browser",
      "minDuration": 24,
      "narration": "先看仪表盘案例一。个人投资者十万闲置资金，点一键演示案例一，走完选股、风险平价和风险度量。离线样本内，风险平价夏普约零点二零，等权约负零点零七，只是历史模拟。",
      "actions": [
        { "goto": "/" },
        { "click": { "testId": "btn-case1" } },
        { "waitFor": { "text": "风险平价夏普", "timeout": 45000 } },
        { "wait": 4000 }
      ]
    },
    {
      "id": "h2",
      "type": "browser",
      "minDuration": 26,
      "narration": "选股页点刷新选股。这里能看到十二个因子、IC IR 动态权重和衰减告警。这是可以解释的研究流程，不是黑盒荐股。",
      "actions": [
        { "goto": "/screen" },
        { "click": { "testId": "btn-screen" } },
        { "waitFor": { "text": "股票池评分", "timeout": 45000 } },
        { "wait": 3000 }
      ]
    },
    {
      "id": "h3",
      "type": "browser",
      "minDuration": 28,
      "narration": "回测页点运行回测，四种策略和六项指标。组合页点优化入选篮子，再点加载 Brinson 归因，把超额拆成配置效应和选择效应。",
      "actions": [
        { "goto": "/backtest" },
        { "click": { "testId": "btn-backtest" } },
        { "waitFor": { "text": "四策略对照", "timeout": 45000 } },
        { "wait": 1500 },
        { "click": { "testId": "nav-portfolio" } },
        { "click": { "testId": "btn-optimize" } },
        { "waitFor": { "text": "风险平价夏普", "timeout": 45000 } },
        { "click": { "testId": "btn-brinson" } },
        { "waitFor": { "text": "Brinson 归因", "timeout": 45000 } },
        { "wait": 2500 }
      ]
    },
    {
      "id": "h4",
      "type": "browser",
      "minDuration": 26,
      "narration": "适当性是申报书创新点五。点填入保守示例，再点提交问卷并匹配。问卷分档后要和风险平价、仓位、波动约束对齐。不匹配就拦截，并写下本地审计摘要，不采集身份证。",
      "actions": [
        { "goto": "/suitability" },
        { "click": { "testId": "btn-preset-conservative" } },
        { "click": { "testId": "btn-suitability-submit" } },
        { "waitFor": { "text": "拦截", "timeout": 45000 } },
        { "wait": 3000 }
      ]
    },
    {
      "id": "h5",
      "type": "browser",
      "minDuration": 24,
      "narration": "风控页点评估风险平价组合，给出历史模拟 VaR、CVaR 和压力情景。请注意：这不是监管报备口径，也不能替代托管估值。",
      "actions": [
        { "goto": "/risk" },
        { "click": { "testId": "btn-risk" } },
        { "waitFor": { "text": "95% VaR", "timeout": 45000 } },
        { "wait": 3000 }
      ]
    },
    {
      "id": "h6",
      "type": "browser",
      "minDuration": 26,
      "narration": "案例二点运行案例二批量回测，再点生成并导出风控报告。这是小型私募研究流程。一亿是名义演示本金，不是已管理规模。Brinson 配置约百分之四点六五，选择约百分之三点一六。",
      "actions": [
        { "goto": "/case2" },
        { "click": { "testId": "btn-case2-run" } },
        { "waitFor": { "text": "名义本金", "timeout": 45000 } },
        { "wait": 1500 },
        { "click": { "testId": "btn-export-report" } },
        { "waitFor": { "text": "已导出", "timeout": 45000 } },
        { "wait": 2500 }
      ]
    },
    {
      "id": "outro",
      "type": "image",
      "path": "assets/demo/outro-card.png",
      "narration": "以上是三分钟产品演示。断网可用离线样本复现。感谢观看。",
      "minDuration": 12
    }
  ]
}
